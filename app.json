{
  "expo": {
    "name": "SwachhLens",
    "slug": "swachhlens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/applogo.png",
    "scheme": "swachhlens",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.anonymous.swachhlens"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/applogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-status-bar",
        {
          "hidden": true
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SwachhLens to access your photos so you can attach a picture to a waste report.",
          "cameraPermission": "Allow SwachhLens to access your camera so you can photograph or record waste issues.",
          "microphonePermission": "Allow SwachhLens to access your microphone to record video waste reports."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow SwachhLens to use your location to tag where a waste issue was reported."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "expo-status-bar": {
        "hidden": true
      },
      "eas": {
        "projectId": "92b8ac95-a374-458c-b938-88eccf6036be"
      }
    }
  }
}
