VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Used by Teams & Assignments' "Add Team" flow to email new team logins
# (see src/lib/emailjs.ts). Get these from your EmailJS dashboard.
VITE_EMAILJS_SERVICE_ID=your-emailjs-service-id
VITE_EMAILJS_TEMPLATE_ID=your-emailjs-template-id
VITE_EMAILJS_PUBLIC_KEY=your-emailjs-public-key

# Used by AI Analytics' "Generate AI Report" to write the report's narrative
# sections (see src/lib/ai-report.ts). Get this from Google AI Studio.
VITE_PUBLIC_GEMINI_API_KEY=your-gemini-api-key
